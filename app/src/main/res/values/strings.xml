    <string name="al_open_listener_settings">Open notification access</string>
    <string name="al_restricted_title">Greyed out or “restricted setting”?</string>
    <string name="al_restricted_steps">Android blocks this for apps installed from a file. Fix it once:\n1. Settings → Apps → Lazee\n2. Tap ⋮ (top right) → Allow restricted settings\n3. Come back and turn on notification access again</string>
